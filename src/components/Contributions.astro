---
import { getContent, type Locale } from "../data/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { contributions, ui } = getContent(lang);
---

<section id="oss">
  <div class="wrap">
    <p class="eyebrow">{ui.oss.eyebrow}</p>
    <h2 class="section-title">{ui.oss.title}</h2>
    <p class="section-lead">{ui.oss.lead}</p>

    <div class="oss-list">
      {contributions.map((c) => (
        <a class="oss-row" href={`https://github.com/${c.repo}`} target="_blank" rel="noreferrer">
          <div class="oss-main">
            <span class="oss-repo mono">{c.repo}</span>
            <span class="oss-role tag">{c.role}</span>
          </div>
          <p class="oss-desc">{c.description}</p>
          <span class="oss-period mono">{c.period}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .oss-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .oss-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    align-items: start;
    padding: 20px 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .oss-row:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .oss-main {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .oss-repo {
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
  }

  .oss-desc {
    grid-column: 1 / -1;
    margin: 2px 0 0;
    color: var(--text-muted);
    font-size: 15px;
  }

  .oss-period {
    font-size: 12px;
    color: var(--text-faint);
    white-space: nowrap;
  }
</style>
