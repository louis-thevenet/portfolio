---
import { getContent, type Locale } from "../data/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { education, ui } = getContent(lang);
---

<section id="education">
  <div class="wrap">
    <p class="eyebrow">{ui.education.eyebrow}</p>
    <h2 class="section-title">{ui.education.title}</h2>
    <p class="section-lead">{ui.education.lead}</p>

    <ol class="timeline">
      {education.map((e) => (
        <li class="entry">
          <div class="entry-when mono">{e.period}</div>
          <div class="entry-body">
            <h3>{e.title}</h3>
            <p class="entry-org mono">{e.org} · {e.location}</p>
              <div class="tags">
              {e.detail.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .entry {
    position: relative;
    padding: 0 0 40px 28px;
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  .entry::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .entry-when {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-faint);
    margin-bottom: 6px;
  }

  .entry-body h3 {
    margin: 0 0 4px;
    font-size: 17.5px;
    font-weight: 600;
    color: var(--navy);
  }

  .entry-org {
    margin: 0 0 12px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--accent);
  }

  .edu-details {
    margin: 0 0 12px;
    padding-left: 18px;
    color: var(--text-muted);
    font-size: 15px;
  }
  .edu-details .tag {
    margin-right: 6px;
    margin-bottom: 6px;
  }

  @media (max-width: 600px) {
    .entry {
      padding-left: 22px;
    }
  }
</style>
