---
import { getContent, type Locale } from "../data/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { profile, experience, education, skills, ui } = getContent(lang);

const current = experience[0];
const school = education.find((e) => e.org === "ENSEEIHT") ?? education[0];

const icons = {
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
  work: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>',
  cap: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.3 2.7 3 6 3s6-1.7 6-3v-5"/></svg>',
  globe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/></svg>',
};

const facts: {
  icon: string;
  label: string;
  value?: string;
  values?: string[];
}[] = [
  { icon: icons.pin, label: ui.hero.basedIn, value: profile.location },
  { icon: icons.work, label: ui.hero.currentRole, value: `${current.title.split("—")[0].trim()} · ${current.org}` },
  { icon: icons.cap, label: ui.hero.studying, value: `${school.org} · ${school.location}` },
  { icon: icons.globe, label: ui.hero.languages, values: skills.spoken },
];

---

<section id="top" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{profile.name}</p>
      <h1>{profile.role}</h1>
      <p class="lede">{profile.tagline}</p>
      <p class="lede secondary">{profile.heroSecondary}</p>
      <div class="cta-row">
        <a class="btn primary" href="#projects">{ui.hero.viewProjects}</a>
        <a class="btn" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="btn" href={`https://github.com/${profile.github}`} target="_blank" rel="noreferrer">GitHub</a>
        <a class="btn js-mail" data-c={profile.emailEnc} href="#">{ui.hero.contact}</a>
      </div>
    </div>

    <aside class="facts" aria-label="Profile summary">
      <div class="pc-head">
        <div>
          <p class="pc-name">{profile.name}</p>
          <p class="pc-role">{profile.role}</p>
        </div>
      </div>

      <span class="pc-status"><span class="pc-dot"></span>{profile.availability}</span>

      <ul class="pc-facts">
        {facts.map((f) => (
          <li class="pc-fact">
            <span class="pc-icon" set:html={f.icon} />
            <span class="pc-text">
              <span class="pc-label">{f.label}</span>
              {f.values
                ? f.values.map((v) => <span class="pc-value">{v}</span>)
                : <span class="pc-value">{f.value}</span>}
            </span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-top: 72px;
    padding-bottom: 88px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .hero-copy h1 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(32px, 4.6vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--navy);
    margin: 0 0 20px;
    max-width: 16ch;
  }

  .lede {
    color: var(--text-muted);
    font-size: 17px;
    max-width: 52ch;
    margin: 0 0 16px;
  }

  .lede.secondary {
    font-size: 15.5px;
    margin-bottom: 30px;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* -- profile card: same themed surface as the project cards -- */
  .facts {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: 26px 26px 22px;
  }

  .pc-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .pc-name {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--navy);
  }

  .pc-role {
    margin: 0;
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .pc-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 500;
    color: #1c7a49;
    background: rgba(46, 158, 99, 0.1);
    border: 1px solid rgba(46, 158, 99, 0.3);
    border-radius: 999px;
    padding: 5px 12px;
    margin-bottom: 22px;
  }

  :global(html[data-theme="dark"]) .pc-status {
    color: #6fd6a0;
    background: rgba(78, 203, 127, 0.12);
    border-color: rgba(78, 203, 127, 0.28);
  }

  .pc-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3fb673;
    box-shadow: 0 0 0 0 rgba(63, 182, 115, 0.6);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(63, 182, 115, 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(63, 182, 115, 0); }
    100% { box-shadow: 0 0 0 0 rgba(63, 182, 115, 0); }
  }

  .pc-facts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pc-fact {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 0;
    border-top: 1px solid var(--border);
  }

  .pc-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .pc-icon :global(svg) {
    width: 17px;
    height: 17px;
  }

  .pc-text {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
    min-width: 0;
  }

  .pc-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-faint);
  }

  .pc-value {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-copy h1 {
      max-width: none;
    }
  }
</style>
