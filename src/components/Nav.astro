---
import { getContent, type Locale } from "../data/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { profile, ui } = getContent(lang);

// French is the default locale, served at "/"; English lives at "/en/".
const otherLang = lang === "fr" ? "en" : "fr";
const otherHref = lang === "fr" ? "/en/" : "/";
const homeHref = lang === "fr" ? "/#top" : "/en/#top";
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href={homeHref} class="brand">{profile.name}</a>
    <nav class="links">
      <a href="#experience">{ui.nav.experience}</a>
      <a href="#projects">{ui.nav.projects}</a>
      <a href="#oss">{ui.nav.oss}</a>
      <a href="#education">{ui.nav.education}</a>
      <a href={otherHref} class="lang-switch" aria-label={`Switch to ${otherLang === "fr" ? "French" : "English"}`}>{otherLang.toUpperCase()}</a>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label={ui.nav.themeToggle}>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
      <a class="btn primary js-mail" data-c={profile.emailEnc} href="#">{ui.nav.contact}</a>
    </nav>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--nav-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--navy);
    text-decoration: none;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 14.5px;
  }

  .links a:not(.btn) {
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .links a:not(.btn):hover {
    color: var(--accent);
  }

  .links .btn {
    padding: 8px 16px;
  }

  .lang-switch {
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--text-muted);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 8px 11px;
    line-height: 1;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .lang-switch:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-toggle svg {
    width: 18px;
    height: 18px;
  }

  /* show the icon of the theme you'll switch TO */
  .theme-toggle .i-sun {
    display: none;
  }
  :global(html[data-theme="dark"]) .theme-toggle .i-sun {
    display: block;
  }
  :global(html[data-theme="dark"]) .theme-toggle .i-moon {
    display: none;
  }

  @media (max-width: 680px) {
    .links a:not(.btn):not(.lang-switch) {
      display: none;
    }
  }
</style>
