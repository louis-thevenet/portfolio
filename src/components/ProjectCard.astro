---
interface Props {
  repo: string; // "owner/name"
  tags: string[];
  fallback: string;
  loading: string;
  viewRepo: string;
  media?: string; // optional demo clip/GIF — see content.ts projectsBase
}
const { repo, tags, fallback, loading, viewRepo, media } = Astro.props;
const name = repo.split("/")[1];
const cardId = `card-${name.toLowerCase().replace(/[^a-z0-9]/g, "-")}`;
// Treat .mp4/.webm as a looping muted video, everything else (.gif/.png) as an image.
const isVideo = !!media && /\.(mp4|webm)$/i.test(media);
---

<article class="card" id={cardId} data-repo={repo} data-fallback={fallback}>
  {/*
    PROJECT DEMO (video / GIF) — placeholder.
    This renders automatically once you set a `media` path for this repo in
    src/data/content.ts (projectsBase) and drop the file in public/videos/.
    Nothing shows while `media` is undefined, so the card stays clean until then.
  */}
  {media && (
    <div class="media">
      {isVideo ? (
        <video src={media} autoplay loop muted playsinline preload="metadata"></video>
      ) : (
        <img src={media} alt={`${name} demo`} loading="lazy" />
      )}
    </div>
  )}

  <div class="card-head">
    <h3>{name}</h3>
    <span class="lang" data-field="language" hidden></span>
  </div>

  <p class="desc" data-field="description">{fallback}</p>

  <div class="tags">
    {tags.map((t) => <span class="tag">{t}</span>)}
  </div>

  <div class="stats mono" data-field="stats">
    <span class="stat-loading">{loading}</span>
  </div>

  <a class="card-link" href={`https://github.com/${repo}`} target="_blank" rel="noreferrer">
    {viewRepo}
  </a>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* demo video / GIF thumbnail (only present when a project has `media`) */
  .media {
    margin: -4px 0 4px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-alt);
    aspect-ratio: 16 / 9;
  }

  .media video,
  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .card-head h3 {
    margin: 0;
    font-size: 16.5px;
    font-weight: 600;
    color: var(--navy);
  }

  .lang {
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--accent);
  }

  .desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.55;
    min-height: 44px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .stats {
    font-size: 12.5px;
    color: var(--text-faint);
    display: flex;
    gap: 16px;
  }

  .stat-loading {
    opacity: 0.7;
  }

  .card-link {
    margin-top: auto;
    padding-top: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }

  .card-link:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }
</style>
