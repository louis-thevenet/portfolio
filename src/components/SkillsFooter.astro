---
import { getContent, type Locale } from "../data/content";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { skills, profile, ui } = getContent(lang);
const year = new Date().getFullYear();
---

<section id="skills">
  <div class="wrap skills-grid">
    <div>
      <p class="eyebrow">{ui.skills.eyebrow}</p>
      <h2 class="section-title" style="margin-bottom:28px">{ui.skills.title}</h2>

      <div class="skill-block">
        <span class="skill-label">{ui.skills.languages}</span>
        <div class="tags">{skills.languages.map((s) => <span class="tag">{s}</span>)}</div>
      </div>
      <div class="skill-block">
        <span class="skill-label">{ui.skills.tools}</span>
        <div class="tags">{skills.tools.map((s) => <span class="tag">{s}</span>)}</div>
      </div>
      <div class="skill-block">
        <span class="skill-label">{ui.skills.spoken}</span>
        <div class="tags">{skills.spoken.map((s) => <span class="tag neutral">{s}</span>)}</div>
      </div>
      <div class="skill-block">
        <span class="skill-label">{ui.skills.interests}</span>
        <div class="tags">{skills.interests.map((s) => <span class="tag neutral">{s}</span>)}</div>
      </div>
    </div>

    <div class="contact-card">
      <p class="eyebrow">{ui.contact.eyebrow}</p>
      <h2 class="section-title" style="font-size:22px;margin-bottom:20px">{ui.contact.title}</h2>
      <p class="contact-intro">{ui.contact.intro}</p>

      <dl class="contact-list">
        <div class="contact-item">
          <dt>{ui.contact.email}</dt>
          <dd>
            <a class="js-mail js-mail-text" data-c={profile.emailEnc} href="#">
              <noscript>enable JavaScript to view</noscript>
            </a>
          </dd>
        </div>
        <div class="contact-item">
          <dt>{ui.contact.phone}</dt>
          <dd>
            <span class="js-phone" data-c={profile.phoneEnc}>
              <noscript>enable JavaScript to view</noscript>
            </span>
          </dd>
        </div>
        <div class="contact-item">
          <dt>{ui.contact.location}</dt>
          <dd>{profile.location}</dd>
        </div>
      </dl>

      <div class="contact-actions">
        <a class="btn primary js-mail" data-c={profile.emailEnc} href="#">{ui.contact.emailMe}</a>
        <a class="btn" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="btn" href={`https://github.com/${profile.github}`} target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </div>
  </div>
</section>

<footer class="wrap site-footer">
  <span>© {year} {profile.name}</span>
  <span>{ui.footer.builtWith}</span>
</footer>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .skill-block {
    margin-bottom: 22px;
  }

  .skill-label {
    display: block;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    margin-bottom: 10px;
  }

  .contact-card {
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: 30px 32px;
  }

  .contact-intro {
    margin: 0 0 24px;
    color: var(--text-muted);
    font-size: 15px;
  }

  .contact-list {
    margin: 0 0 26px;
    border-top: 1px solid var(--border);
  }

  .contact-item {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  .contact-item dt {
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .contact-item dd {
    margin: 0;
    font-size: 15px;
    color: var(--text);
  }

  .contact-item dd a {
    color: var(--accent);
    text-decoration: none;
  }

  .contact-item dd a:hover {
    text-decoration: underline;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    padding: 28px 28px 40px;
    font-size: 13px;
    color: var(--text-faint);
  }

  @media (max-width: 760px) {
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
</style>

<script>
  // Decode contact details in the browser so the raw email/phone never appear in
  // the served HTML (basic scraper mitigation). Values are base64-encoded then
  // reversed in src/data/content.ts. This runs once and wires up every
  // `.js-mail` / `.js-phone` on the page (Nav, Hero and the contact card).
  const decode = (enc: string) => atob([...enc].reverse().join(""));

  document.querySelectorAll<HTMLAnchorElement>("a.js-mail").forEach((a) => {
    const enc = a.dataset.c;
    if (!enc) return;
    const email = decode(enc);
    a.href = `mailto:${email}`;
    if (a.classList.contains("js-mail-text")) a.textContent = email;
  });

  document.querySelectorAll<HTMLElement>(".js-phone").forEach((el) => {
    const enc = el.dataset.c;
    if (enc) el.textContent = decode(enc);
  });
</script>
